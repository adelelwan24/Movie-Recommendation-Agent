# Environment configuration for the TMDB movie agent.
#
# GENERATED by scripts/gen_env_example.py from movieagent.config.Settings.
# Do not hand-edit: regenerate instead, or the file drifts from the code (R-112).
#
# Copy to .env and fill in what you need. Everything has a working default except
# LLM_API_KEY -- and the deterministic half of the system (preprocessing,
# structured search, fuzzy matching, local embeddings) runs without even that.

# --------------------------------------------------------------------------
# LLM — chat and tool calling (R-117)
# --------------------------------------------------------------------------
# Chat/tool-calling endpoint. OpenRouter by default; point at a vLLM server to
# switch.
LLM_BASE_URL=https://openrouter.ai/api/v1
# REQUIRED for the agent. Not needed to build the index or run
# structured/fuzzy search.
LLM_API_KEY=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
# Must support native tool calling.
LLM_MODEL=openai/gpt-4o-mini
# 0 keeps routing reproducible.
LLM_TEMPERATURE=0.0
# Per-request timeout in seconds.
LLM_TIMEOUT_S=60.0
# Retries on 429/5xx/timeout, handled by the client (R-087).
LLM_MAX_RETRIES=3

# --------------------------------------------------------------------------
# Embeddings — independent of the LLM endpoint (R-118, ADR-0007)
# --------------------------------------------------------------------------
# sentence_transformers (local, default) | openai_compatible
EMBEDDING_PROVIDER=sentence_transformers
# Changing this invalidates the built index. Rebuild after changing it.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ONLY for embedding_provider=openai_compatible, and INDEPENDENT of
# LLM_BASE_URL. OpenRouter serves no /v1/embeddings endpoint -- point this at
# OpenAI, vLLM, Ollama or LM Studio.
EMBEDDING_BASE_URL=
# Only for embedding_provider=openai_compatible.
EMBEDDING_API_KEY=
# Documents per embedding request/batch.
EMBEDDING_BATCH_SIZE=64

# --------------------------------------------------------------------------
# Retrieval (ADR-0011, ADR-0026)
# --------------------------------------------------------------------------
# Default number of semantic results.
TOP_K=8
# Backstop only. An absolute cosine threshold cannot separate real queries
# from gibberish on this corpus (ADR-0026); MIN_LEXICAL_COVERAGE is the real
# signal.
SIMILARITY_FLOOR=0.35
# Fraction of a query's content words that must appear in the corpus
# vocabulary before retrieval is trusted. Below this, the tool reports low
# confidence.
MIN_LEXICAL_COVERAGE=0.4
# Rows shown per structured result; the true total is always reported.
RESULT_DISPLAY_LIMIT=25

# --------------------------------------------------------------------------
# Fuzzy title matching (ADR-0025)
# --------------------------------------------------------------------------
# Score at or above which a title match is accepted (ADR-0025).
FUZZY_ACCEPT=82
# Below this, the title is reported as not found.
FUZZY_AMBIGUOUS=65
# If the top two candidates are within this, ask instead of guessing.
FUZZY_TIE_MARGIN=3
# Candidates offered when a title is ambiguous.
FUZZY_MAX_CANDIDATES=5

# --------------------------------------------------------------------------
# Agent loop guards (ADR-0021, ADR-0022)
# --------------------------------------------------------------------------
# LangGraph recursion cap for the agent<->tools cycle.
RECURSION_LIMIT=25
# Hard cap on tool calls per turn.
MAX_TOOL_ITERATIONS=6
# Wall-clock budget for one turn.
TURN_TIMEOUT_S=90.0
# Raw chat messages kept in state; structured memory carries the rest.
MESSAGE_WINDOW=8

# --------------------------------------------------------------------------
# Paths
# --------------------------------------------------------------------------
# Where the TMDB CSVs live.
DATA_DIR=D:\Docs\Current\Movie Recommendation Agent\data
# Where the build step writes movies.parquet, embeddings.npy and
# manifest.json.
ARTIFACTS_DIR=D:\Docs\Current\Movie Recommendation Agent\artifacts

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Optional path for a log file; stderr only when unset.
LOG_FILE=
